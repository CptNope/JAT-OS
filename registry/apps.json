{
  "$schema": "./manifest.schema.json",
  "registryVersion": 1,
  "note": "Demonstration registry for the JAT OS example. Descriptions are summaries from each app's name and should be confirmed by the app owner; versions are null because the apps do not declare one yet.",
  "apps": [
    {
      "id": "com.jeremyandersontech.vectorcraft",
      "name": "VectorCraft",
      "shortName": "VectorCraft",
      "description": "Vector illustration and path editing.",
      "version": null,
      "icon": {
        "src": "assets/apps/vectorcraft.svg",
        "color": "#7B4DFF"
      },
      "category": "graphics",
      "launch": {
        "url": "https://cptnope.github.io/vectorcraft/",
        "mode": "embedded",
        "fallback": "external",
        "scope": "https://cptnope.github.io/vectorcraft/"
      },
      "window": {
        "minWidth": 720,
        "minHeight": 480,
        "preferredWidth": 1180,
        "preferredHeight": 760,
        "resizable": true,
        "appThemeColor": "#101827"
      },
      "permissions": [],
      "capabilities": {
        "offline": "app-managed",
        "serviceWorkerScope": "https://cptnope.github.io/vectorcraft/",
        "bridge": null,
        "pointer": [
          "mouse",
          "touch"
        ],
        "pen": "unverified"
      },
      "integration": {
        "bridgeVersion": null,
        "endpoints": []
      },
      "publisher": {
        "name": "Jeremy Anderson Tech",
        "url": "https://github.com/CptNope"
      },
      "source": "user-owned PWA on GitHub Pages"
    },
